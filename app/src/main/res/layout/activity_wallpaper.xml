<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101820"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wallpaperBackButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="24dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALLPAPER GALLERY"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Choose which screen to customise -->
    <RadioGroup
        android:id="@+id/wallpaperTargetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp">

        <RadioButton
            android:id="@+id/homeWallpaperOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOME SCREEN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:checked="true"
            android:layout_marginEnd="50dp" />

        <RadioButton
            android:id="@+id/appsWallpaperOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL APPS"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </RadioGroup>

    <!-- Wallpaper thumbnails will appear here -->
    <GridView
        android:id="@+id/wallpaperGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:horizontalSpacing="16dp"
        android:verticalSpacing="16dp"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Select your own image -->
    <Button
        android:id="@+id/browseWallpaperButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="BROWSE MY OWN PICTURE"
        android:textSize="17sp" />

</LinearLayout>
